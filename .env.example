# Referência de TODAS as variáveis suportadas pelo backend.
# Copie para backend/.env (config principal). Opcional: env.local na raiz só com overrides (ex. GITLAB_*).
# Ordem de carga (último vence): .env (raiz, se existir) → backend/.env → env.local (raiz).
# Guia de execução: repositorio.md

# Opcional: mesmo token do proxy gravado com outro nome (o fluxo principal é LITELLM_*).
OPENAI_API_KEY=

# LiteLLM proxy — chave e URL base (obrigatórios para tutorial + UI de modelos; transcrição multimodal idem)
LITELLM_API_KEY=
LITELLM_ENDPOINT=https://llm.testes.defpub.local/
# TLS para HTTPS do proxy: false só em dev com cert interno/self-signed (em produção prefira LITELLM_SSL_CA_BUNDLE)
LITELLM_HTTP_VERIFY_SSL=false
# Caminho absoluto ou relativo a um PEM da CA (confia na cadeia sem desligar verify)
LITELLM_SSL_CA_BUNDLE=
# Modelo padrão quando a UI não envia outro (slug exatamente como o proxy aceita, ex.: azure_ai/…, gemini/…).
# Primeira geração do tutorial: só texto (transcrição + caminhos em assets/); regeneração pelo FAB anexa pixels só para ![](assets/…png) já presentes no Markdown — aí convém modelo com visão.
LITELLM_MODEL=openai/gpt-4o-mini
# Opcional: lista separada por vírgula = modelos que a UI pode escolher (whitelist). Se vazio, o cliente pode pedir qualquer modelo (texto livre validado só como não-vazio).
# Ex.: LITELLM_MODELOS_PROVISIONADOS=openai/gpt-4o-mini,openai/gpt-4o
# Inclua slugs com -tts para o select de narração (ex.: gemini/gemini-2.5-flash-preview-tts, gemini/gemini-2.5-pro-preview-tts).
LITELLM_MODELOS_PROVISIONADOS=azure_ai/claude-sonnet-4-6,azure_ai/claude-opus-4-6,azure_ai/claude-haiku-4-5,gemini/gemini-3.1-pro-preview,gemini/gemini-3.1-flash-lite,gemini/gemini-3.1-flash-lite-preview,gemini/gemini-3-flash-preview,gemini/gemini-3-pro-preview,gemini/gemini-2.5-flash-preview-tts,gemini/gemini-2.5-pro-preview-tts

# Transcrição: openai_whisper (API /v1/audio/transcriptions) ou litellm_multimodal_audio (chat + áudio inline WAV ou MP3 via LiteLLM, ex. gemini/)
TRANSCRICAO_BACKEND=litellm_multimodal_audio
# Modelo usado só se TRANSCRICAO_BACKEND=litellm_multimodal_audio (se vazio, usa o primeiro gemini/ de LITELLM_MODELOS_PROVISIONADOS ou LITELLM_MODEL)
TRANSCRICAO_LITELLM_MODELO=gemini/gemini-3.1-flash-lite
# Tamanho de cada janela WAV (segundos) — padrão até subir o servidor; depois a UI pode gravar overrides no SQLite (gaveta Configurações).
TRANSCRICAO_MULTIMODAL_JANELA_SEGUNDOS=30
# Máximo de trechos em paralelo — idem (UI PATCH persiste em runtime_config_valores_transcribrothers no sqlite do data dir).
# Atenção: paralelismo > 1 nem sempre acelera; se o LiteLLM/provedor serializar ou limitar taxa, o tempo POR TRECHO pode aumentar. Nesse caso use 1.
TRANSCRICAO_MULTIMODAL_JANELAS_PARALELAS_MAXIMA=5
# Formato do áudio inline no JSON ao LiteLLM: wav, mp3, opus ou aac (m4a). A gaveta Configurações pode gravar override no SQLite (PATCH runtime).
TRANSCRICAO_MULTIMODAL_FORMATO_AUDIO_INLINE=aac
# Bitrate (kbps) para mp3, opus e aac; ignorado para wav. A gaveta pode sobrescrever via SQLite. Alias legado: TRANSCRICAO_MULTIMODAL_MP3_BITRATE_KBPS.
TRANSCRICAO_MULTIMODAL_AUDIO_BITRATE_KBPS=32
# true = extrair/codificar em mono (1 canal). A gaveta pode sobrescrever via SQLite.
TRANSCRICAO_MULTIMODAL_AUDIO_MONO=true
# true = envia response_format json_object no chat de transcrição multimodal (OpenAI-compatible); o cliente repete sem o campo se o proxy rejeitar.
TRANSCRICAO_LITELLM_CHAT_JSON_OBJECT_RESPONSE_FORMAT=true

# Timeouts HTTP (segundos) para POST longos ao proxy LiteLLM (transcrição por trechos + tutorial)
# Se aparecer HTTP 504 com HTML do nginx, o gargalo costuma ser proxy_read_timeout no nginx (maior que este valor).
LITELLM_HTTP_TIMEOUT_CONNECT_SEGUNDOS=120
LITELLM_HTTP_TIMEOUT_READ_SEGUNDOS=7200

# Limites
MAX_VIDEO_BYTES=524288000
MAX_FRAMES_PER_MINUTE=12
# Teto opcional de screenshots no tutorial (além do limite por minuto). 0 = só MAX_FRAMES_PER_MINUTE.
TUTORIAL_MAX_FRAMES_TOTAL=0
# Largura máxima (px) ao capturar PNG para o tutorial (ffmpeg scale). 0 = não redimensionar. Padrão 1280.
TUTORIAL_FRAME_MAX_WIDTH_PX=1280
# Regeneração «revisão profunda» (POST regenerate-tutorial com revisao_profunda_multifase=true): máximo de tópicos do plano (1–32; o servidor faz clamp).
REVISAO_PROFUNDA_MAX_TOPICOS=8

# Verificação pós-geração: o servidor compara o tutorial Markdown à transcrição (chamada extra ao LiteLLM, saída JSON em steps_json).
# VERIFICACAO_SUSTENTACAO_TUTORIAL_DESATIVADA=true desliga a etapa (útil em testes ou se o proxy estiver instável).
# VERIFICACAO_SUSTENTACAO_TUTORIAL_MAX_CHARS_PAYLOAD_TRANSCRICAO_JSON e VERIFICACAO_SUSTENTACAO_TUTORIAL_MAX_CHARS_MARKDOWN_ENVIADO afinam o tamanho do texto enviado ao modelo.
# VERIFICACAO_SUSTENTACAO_TUTORIAL_DESATIVADA=false
# VERIFICACAO_SUSTENTACAO_TUTORIAL_MAX_CHARS_PAYLOAD_TRANSCRICAO_JSON=90000
# VERIFICACAO_SUSTENTACAO_TUTORIAL_MAX_CHARS_MARKDOWN_ENVIADO=120000
# Edição por seção: auditor de redundância com outras seções ## (após regenerar uma seção).
# VERIFICACAO_REDUNDANCIA_SECAO_MARKDOWN_DESATIVADA=true desliga essa verificação.
# VERIFICACAO_REDUNDANCIA_SECAO_MAX_CHARS_CORPO_OUTRA_SECAO=3500
# VERIFICACAO_REDUNDANCIA_SECAO_MAX_OUTRAS_SECOES=12
# Correção automática após redundância: Configurações → Redundância (edição por seção) na interface.

# CORS (desenvolvimento: mesma origem do Vite)
CORS_ORIGINS=http://localhost:5183,http://localhost:5173,http://127.0.0.1:5183

# Diretório de dados (jobs e sqlite)
TRANSCRIBROTHERS_DATA_DIR=./data

# ffmpeg/ffprobe — se o uvicorn não achar no PATH (comum no Windows com ffprobe instalado via WinGet no terminal mas não no serviço):
# FFMPEG_BIN_DIR=C:\caminho\para\pasta\bin
# ou caminhos completos:
# FFMPEG_PATH=C:\...\ffmpeg.exe
# FFPROBE_PATH=C:\...\ffprobe.exe

# GitLab — toolbar (criar issue, comentar, anexar descrição, wiki). Token só no servidor.
# Recomendado: GITLAB_* em env.local na raiz (sobrescreve backend/.env); não commitar.
GITLAB_BASE_URL=
GITLAB_TOKEN=
# true/1 em dev com certificado interno (equivalente à skill criar-issue-gitlab)
GITLAB_TLS_INSECURE_DEV=false
# GITLAB_CREATE_ISSUE_PROJECT_PATH=portal-da-defensoria/portal-defensoria-gateway
# GITLAB_CREATE_ISSUE_DEFAULT_LABELS=squad::bravo
# GITLAB_WIKI_PROJECT_PATH=portal-da-defensoria/documentacao
# GITLAB_WIKI_SLUG_PREFIXO_PASTA=workshop
