# Copie para env.local na raiz do repositório (não commitar env.local).
# Carregado depois de backend/.env; só precisa das chaves que quiser sobrescrever ou adicionar.
# Guia completo: repositorio.md

GITLAB_BASE_URL=
GITLAB_TOKEN=

# Opcional — certificado interno em dev
# GITLAB_TLS_INSECURE_DEV=false

# Opcional — wiki (toolbar «Publicar na wiki»)
# GITLAB_WIKI_PROJECT_PATH=portal-da-defensoria/documentacao
# GITLAB_WIKI_SLUG_PREFIXO_PASTA=workshop
